{
  "name": "portal-automacao-nf",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "db:apply-migrations": "node scripts/apply-migrations.mjs",
    "probe:pooler": "pnpm --filter frontend probe:pooler",
    "vendor:nfse-dist": "node scripts/vendor-nfse-dist.mjs",
    "setup:adn-playwright": "node scripts/setup-adn-playwright.mjs",
    "sync:adn-extension-from-chrome": "node scripts/sync-adn-extension-from-chrome.mjs",
    "adn:enqueue-real-company": "python scripts/enqueue_adn_real_company_job.py",
    "force:adn-bridge": "node scripts/run-adn-bridge-force-once.mjs",
    "smoke:adn-bridge": "node scripts/run-adn-bridge-smoke-once.mjs",
    "worker:adn-bridge": "node scripts/run-adn-bridge-watch.mjs",
    "docker:build-adn-worker": "docker build -f Dockerfile.adn-worker -t nfse-adn-worker .",
    "fix:adn-stale-jobs": "node scripts/release-stale-adn-jobs.mjs",
    "fix:adn-all-running": "node scripts/fix-adn-all-running-now.mjs",
    "status:adn-jobs": "node scripts/adn-jobs-status.mjs",
    "dev:with-adn-bridge": "concurrently -k -n \"portal,adn\" -c \"cyan,magenta\" \"pnpm dev:frontend\" \"pnpm worker:adn-bridge\"",
    "dev:with-adn-bridge-backend": "concurrently -k -n \"portal,adn\" -c \"cyan,magenta\" \"pnpm dev:backend\" \"pnpm worker:adn-bridge\"",
    "dev:auto": "pnpm --filter backend dev:auto",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "is-regex": "^1.2.1",
    "postgres": "^3.4.5",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "is-regex": "^1.2.1"
  }
}
